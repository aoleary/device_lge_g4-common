soong_config_module_type {
    name: "lge_vibrator",
    module_type: "cc_defaults",
    config_namespace: "lgeVibratorVars",
    bool_variables: ["duration_amplitude"],
    properties: ["cflags"],
}

lge_vibrator {
    name: "lge_vibrator_defaults",
}

cc_binary {
    name: "android.hardware.vibrator-service.lge",
    defaults: ["lge_vibrator_defaults"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.lge.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.lge.xml"],
    srcs: [
        "Vibrator.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V2-ndk",
    ],
    vendor: true,
}
