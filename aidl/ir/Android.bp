cc_binary {
    name: "android.hardware.ir-service.lge",
    relative_install_path: "hw",
    init_rc: ["android.hardware.ir-service.lge.rc"],
    vendor: true,
    vintf_fragments: ["android.hardware.ir-service.lge.xml"],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "android.hardware.ir-V1-ndk",
        "libhardware",
    ],

    srcs: ["main.cpp"],
}

prebuilt_etc {
    name: "android.hardware.ir-service.lge.rc",
    src: ":gen-android.hardware.ir-service.lge.rc",
    installable: false,
}

genrule {
    name: "gen-android.hardware.ir-service.lge.rc",
    srcs: ["android.hardware.ir-service.lge.rc"],
    out: ["android.hardware.ir-service.lge.apex.rc"],
    cmd: "sed -e 's@/vendor/bin/@/apex/com.android.hardware.ir/bin/@' $(in) > $(out)",
}

prebuilt_etc {
    name: "android.hardware.ir-service.lge.xml",
    src: "android.hardware.ir-service.lge.xml",
    sub_dir: "vintf",
    installable: false,
}

filegroup {
    name: "com.android.hardware.ir_file_contexts",
    srcs: ["apex_file_contexts"],
}

filegroup {
    name: "com.android.hardware.ir_apex_manifest.json",
    srcs: ["apex_manifest.json"],
}

apex_defaults {
    name: "com.android.hardware.ir",
    // Reference to the filegroup instead of direct path since
    // paths in defaults don't work in a different directory.
    file_contexts: ":com.android.hardware.ir_file_contexts",
    manifest: ":com.android.hardware.ir_apex_manifest.json",

    updatable: false,
    vendor: true,

    binaries: [
        "android.hardware.ir-service.lge",
    ],
    prebuilts: [
        "android.hardware.ir-service.lge.rc",
        "android.hardware.ir-service.lge.xml",
        "android.hardware.consumerir.prebuilt.xml", // feature
    ],
}
