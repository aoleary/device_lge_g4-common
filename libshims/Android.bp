cc_library_shared {
    name: "libqsap_shim",
    srcs: ["libqsap_shim.c"],
    shared_libs: [
        "libqsap_sdk",
        "liblog",
    ],
    include_dirs: ["device/lge/g4-common/softap/sdk"],

    proprietary: true,
}


// cameraclient
cc_library_shared {
    name: "libshim_cameraclient",
    srcs: ["cameraclient_shim.cpp"],
    vendor: true,

}

// Fence
cc_library_shared {
    name: "libfence_shim",
    srcs: ["fence.cpp"],

    vendor: true,
}

// RTP
cc_library_shared {
    name: "ims_rtp_shim",
    srcs: ["rtp.cpp"],

    vendor: true,
    arch: {
        arm64: {
            cflags: ["-DLIBSHIMS_64BIT"],
        },
    },
}

// Slim_shim
cc_library_shared {
    name: "slim_shim",
    srcs: ["slim_shim.cpp"],

    vendor: true,
    arch: {
        arm64: {
            cflags: ["-DLIBSHIMS_64BIT"],
        },
    },
}
// AudioSystem
cc_library_shared {
    name: "libaudioclient_shim_g4",
    srcs: ["libaudioclient_shim.cpp"],
    vendor: true,

}

cc_library_shared {
    name: "libshims_thermal",
    srcs: ["libshims_thermal.cpp"],
    cflags: ["-Wno-unused-parameter"],

    vendor: true,
}
