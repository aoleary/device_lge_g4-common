cc_library_shared {
    name: "libmdmdetect",

    srcs: ["*.c"],

    local_include_dirs: [
        "libmdmdetect",
    ],

    include_dirs: [
        "$(TARGET_OUT_HEADERS)/common/inc",
    ],

    shared_libs: [
        "libcutils",
        "libutils",
    ],

    cflags: [
        "-Wall",
    ],

    ldflags: [
        "-llog",
    ],

    proprietary: true,
    vendor: true,
    owner: "qcom",
}